# Connect to existing noetfield-earnloop Railway Postgres, do NOT create/replace its volume.
DATABASE_URL=postgresql://user:password@localhost:5432/earnloop
NODE_ENV=production
PORT=3000
# Generate random 32+ bytes (e.g. openssl rand -hex 32), set privately in Railway. No default.
COMPANY_OS_ADMIN_TOKEN=
# Future advertising partner: configure only after approved contract + callback specification.
PARTNER_NAME=
PARTNER_POSTBACK_SECRET=
# Never claim activated real inventory before an approved provider supplies it.
APPROVED_OFFERWALL_URL=

# Optional: founder-gated, one-at-a-time commercial outreach. Never commit real values.
# The sender domain MUST be authorized with the mail provider; outbound is disabled otherwise.
COMMERCIAL_FOUNDER_APPROVAL_TOKEN=
RESEND_API_KEY=
OUTREACH_FROM=
# Exact explicitly permitted external addresses, comma-separated. No bulk send.
OUTREACH_ALLOWED_RECIPIENTS=

# OPTIONAL native Torox API: true only if account manager enables API entitlement.
# Hosted Torox wall remains independent of this flag.
TOROX_PUBLISHER_APPROVED=false
TOROX_APPROVAL_REFERENCE=
TOROX_PLACEMENT_ID=
TOROX_APP_TOKEN=
TOROX_MODE=staging
TOROX_API_ENABLED=false
